JSC_DRIVER = r'''
const bytes = readFile(arguments[0], "binary");
if (!WebAssembly.validate(bytes)) { print("E invalid wasm"); throw 0; }
const mod = new WebAssembly.Module(bytes);
if (WebAssembly.Module.imports(mod).length) { print("E unexpected import"); throw 0; }
const ex = new WebAssembly.Instance(mod, {}).exports;
const W = {bool:1,uchar:8,ushort:16,uint:32,ulong:64,byte:8,short:16,int:32,long:64};
const S = {byte:1,short:1,int:1,long:1};
const out = [];
for (const line of readFile(arguments[1]).split("\n")) {
  if (!line) continue;
  const p = line.split(" "), name = p[0], ret = p[1];
  const args = p.slice(2).map(a => { const [t, v] = a.split(":"); return W[t] === 64 ? BigInt(v) : Number(v); });
  try {
    let r = ex[name](...args);
    if (ret === "void") r = 0n;
    else if (W[ret] === 64) r = BigInt(r);
    else r = S[ret] ? BigInt.asIntN(W[ret], BigInt(r)) : BigInt.asUintN(W[ret], BigInt(r));
    out.push("V " + r.toString());
  } catch (e) {
    out.push(e instanceof WebAssembly.RuntimeError ? "T " + e.message : "E " + e);
  }
}
print(out.join("\n"));
'''


def run_wasm_jsc(wasm_bytes, fns, vectors):
