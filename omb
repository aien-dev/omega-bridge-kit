FORMS = ["ORIGINAL", "OM>C", "OM>PY", "NATIVE", "WASM", "RT-C", "RT-PY"]
HERE = "MAC" if sys.platform == "darwin" else "HOST-" + os.uname().sysname.upper()   # where omb itself runs
FORM_WHERE = {f: HERE for f in FORMS}
TYPES = {"bool": (1, False), "uchar": (8, False), "ushort": (16, False), "uint": (32, False),
         "ulong": (64, False), "byte": (8, True), "short": (16, True), "int": (32, True), "long": (64, True)}
CTYPE = {"bool": "uint8_t", "uchar": "uint8_t", "ushort": "uint16_t", "uint": "uint32_t", "ulong": "uint64_t",
         "byte": "int8_t", "short": "int16_t", "int": "int32_t", "long": "int64_t"}
M64 = (1 << 64) - 1
TRAPS = {1: "overflow", 2: "divide by zero", 3: "bounds", 4: "loop bound", 5: "conversion", 6: "resource",
         7: "shift", 8: "invalid argument", 9: "reentry"}


class OmbError(Exception):
    def __init__(self, msg, code=65):
        super().__init__(msg)
        self.code = code


# ---------------------------------------------------------------- logging
EVENTS = []          # every command run, MAC or SPARK; the UI shows these verbatim
QUIET = False


def log_event(where, cmd, rc, ms, note=""):
    ev = {"where": where, "cmd": cmd, "rc": rc, "ms": round(ms, 1), "note": note, "t": time.time()}
    EVENTS.append(ev)
    if not QUIET:
        sys.stderr.write("[%s] $ %s  (rc=%s, %.0f ms%s)\n" % (where, cmd, rc, ms, ", " + note if note else ""))
    return ev


def sh_join(cmd):
    return " ".join(shlex.quote(c) for c in cmd)


class mac_lock:
    """On macOS, serialize timing runs with every other lane using the Mac:
    the same lock file `/usr/bin/lockf -k ~/omega-work/.mac.lock` takes (flock semantics).
    Skipped when an outer lockf already holds it (OMB_MAC_LOCK_HELD=1) or off macOS."""
    def __enter__(self):
        self.fh = None
        if sys.platform != "darwin" or os.environ.get("OMB_MAC_LOCK_HELD") == "1":
            return self
        import fcntl
        d = os.path.expanduser("~/omega-work")
        os.makedirs(d, exist_ok=True)
        self.fh = open(os.path.join(d, ".mac.lock"), "a")
        t = time.time()
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        log_event(HERE, "flock ~/omega-work/.mac.lock  # same lock as /usr/bin/lockf -k", 0, (time.time() - t) * 1000, "waited for lock")
        return self

    def __exit__(self, *a):
        if self.fh:
            self.fh.close()


def run_local(cmd, data=b"", timeout=600, show=None, cwd=None):
    t = time.time()
    try:
        p = subprocess.run(cmd, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, cwd=cwd)
        rc, out, err = p.returncode, p.stdout, p.stderr
    except FileNotFoundError as e:
        rc, out, err = 127, b"", str(e).encode()
    except subprocess.TimeoutExpired:
        rc, out, err = 124, b"", b"timeout"
    ms = (time.time() - t) * 1000
    log_event(HERE, show or sh_join(cmd), rc, ms)
    return rc, out, err, ms


# ---------------------------------------------------------------- pins
def read_pins(path=None):
    path = path or os.path.join(KIT, "PINS")
    raw = open(path, "rb").read()
    pins = {}
    for line in raw.decode().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            pins[k] = v
    return pins, hashlib.sha256(raw).hexdigest()


PINS, PINS_SHA = read_pins()


def sha256_file(p):
    return hashlib.sha256(open(p, "rb").read()).hexdigest()


# ---------------------------------------------------------------- Spark over ssh
FRESH = False


def remote(op, data, cacheable=True):
    """Run one omb-remote.sh op on the Spark. Returns (rc, out, err, ms, cached)."""
    cmd = ["ssh", "-o", "BatchMode=yes", SPARK, "sh", REMOTE_KIT + "/remote/omb-remote.sh", op, PINS_SHA]
    key = hashlib.sha256(op.encode() + b"\0" + PINS_SHA.encode() + b"\0" + data).hexdigest()
    cdir = os.path.join(WORK, "cache", key[:2])
    cfile = os.path.join(cdir, key + ".json")
    if cacheable and not FRESH and os.path.exists(cfile):
        c = json.load(open(cfile))
        log_event("SPARK via ssh", sh_join(cmd) + " < input", c["rc"], 0,
                  "cached: same input+PINS converted over ssh earlier (%.0f ms then); --fresh reruns" % c["ms"])
        return c["rc"], base64.b64decode(c["out"]), base64.b64decode(c["err"]), 0.0, True
    t = time.time()
    p = subprocess.run(cmd, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    ms = (time.time() - t) * 1000
    log_event("SPARK via ssh", sh_join(cmd) + " < input", p.returncode, ms)
    if p.returncode == 255:
        raise OmbError("ssh to %s failed: %s" % (SPARK, p.stderr.decode(errors="replace").strip()))
    if p.returncode in (65, 66):
        raise OmbError(p.stderr.decode(errors="replace").strip() + " (run: ./omb setup)")
    if cacheable and p.returncode in (0,) + tuple(range(1, 64)) + (110,):
        os.makedirs(cdir, exist_ok=True)
        json.dump({"rc": p.returncode, "ms": ms, "out": base64.b64encode(p.stdout).decode(),
                   "err": base64.b64encode(p.stderr).decode()}, open(cfile, "w"))
    return p.returncode, p.stdout, p.stderr, ms, False


def setup():
    cmd = "tar -cf - PINS remote | ssh -o BatchMode=yes %s 'D=$HOME/%s; mkdir -p \"$D\" && tar -xf - -C \"$D\" && sh \"$D/remote/setup.sh\"'" % (
        shlex.quote(SPARK), REMOTE_KIT)
    t = time.time()
    p = subprocess.run(["sh", "-c", cmd], cwd=KIT)
    log_event("SPARK via ssh", cmd, p.returncode, (time.time() - t) * 1000)
    return p.returncode


# ---------------------------------------------------------------- lifter (on this Mac)
def lifter_status():
    for k in ("LIFT_SHA", "LIFT_C_SHA256", "LIFT_PY_SHA256"):
        if PINS.get(k, "PENDING") == "PENDING":
            return "lifter not pinned yet (%s=PENDING in PINS)" % k
    for f, k in (("gen/lift.c", "LIFT_C_SHA256"), ("gen/lift.py", "LIFT_PY_SHA256")):
        p = os.path.join(KIT, f)
        if not os.path.exists(p):
            return "%s missing" % f
        if sha256_file(p) != PINS[k]:
            return "%s sha256 %s differs from PINS %s" % (f, sha256_file(p), PINS[k])
    return None


def cc():
    return shutil.which("clang") or shutil.which("cc") or "cc"


def lift_binary():
    why = lifter_status()
    if why:
        raise OmbError(why, 2)
    out = os.path.join(WORK, "bin", "lift-" + PINS["LIFT_C_SHA256"][:16])
    if not os.path.exists(out):
        os.makedirs(os.path.dirname(out), exist_ok=True)
        rc, _, err, _ = run_local([cc(), "-std=gnu11", "-O2", "-w", "-o", out + ".tmp", os.path.join(KIT, "gen/lift.c")])
        if rc:
            raise OmbError("clang could not build gen/lift.c: " + err.decode(errors="replace")[:400], 2)
        os.replace(out + ".tmp", out)
    return out


def lift(lang, src, impl="c"):
    """lang 'c'|'py'. impl 'c' = clang-built gen/lift.c, 'py' = python3 gen/lift.py, 'spark' = remote."""
    data = (b"c" if lang == "c" else b"p") + src
    if impl == "spark":
        rc, out, err, ms, _ = remote("lift-c" if lang == "c" else "lift-py", src)
        return rc, out, err, ms, "SPARK"
    if impl == "c":
        cmd = [lift_binary()]
        show = "%s < input  # lift.c built by clang from gen/lift.c, selector '%s'" % (os.path.relpath(cmd[0], KIT), data[:1].decode())
    else:
        why = lifter_status()
        if why:
            raise OmbError(why, 2)
        cmd = [sys.executable, os.path.join(KIT, "gen/lift.py")]
        show = "python3 gen/lift.py < input  # selector '%s'" % data[:1].decode()
    rc, out, err, ms = run_local(cmd, data, show=show)
    return rc, out, err, ms, HERE


SKIP_RE = re.compile(r"^lift: skip (\S+) line (\d+): (.*)$")
FATAL_RE = re.compile(r"^lift: line (\d+): (.*)$")


def parse_lift_err(err):
    skips, fatal, other = [], [], []
    for line in err.decode(errors="replace").splitlines():
        m = SKIP_RE.match(line)
        if m:
            skips.append({"name": m.group(1), "line": int(m.group(2)), "reason": m.group(3)})
            continue
        m = FATAL_RE.match(line)
        if m:
            fatal.append({"line": int(m.group(1)), "reason": m.group(2)})
        elif line.strip():
            other.append(line)
    return skips, fatal, other


# ---------------------------------------------------------------- .om units
class Fn:
    def __init__(self, name, params, ret, start, end, lines):
        self.name, self.params, self.ret = name, params, ret
        self.start, self.end, self.lines = start, end, lines     # 1-based inclusive line numbers
        self.calls = set()
        self.scalar = all(t in TYPES for _, t in params) and (ret in TYPES or ret == "void")

    def sig(self):
        return "%s(%s) -> %s" % (self.name, ", ".join("%s %s" % p for p in self.params), self.ret)


def parse_unit(text):
    """Split an .om function unit into functions. Returns (header_lines, [Fn], orig_names)."""
    lines = text.split("\n")
    fns, header, orig = [], [], {}
    cur = None
    for i, line in enumerate(lines, 1):
        s = line.strip()
        m = re.match(r"note orig (\S+) -> (\S+)", s)
        if m:
            orig[m.group(2)] = m.group(1)
        if line.startswith("fn "):
            toks = line.split()
            name = toks[1]
            if "to" in toks:
                ti = toks.index("to")
                ret = " ".join(toks[ti + 1:])
                ptoks = toks[2:ti]
            else:
                ret, ptoks = "void", toks[2:]
            params, j = [], 0
            while j < len(ptoks):
                pname = ptoks[j]
                if j + 1 < len(ptoks) and ptoks[j + 1] in ("edit", "view"):
                    params.append((pname, " ".join(ptoks[j + 1:j + 4])))
                    j += 4
                else:
                    params.append((pname, ptoks[j + 1] if j + 1 < len(ptoks) else "?"))
                    j += 2
            cur = Fn(name, params, ret, i, i, [line])
            fns.append(cur)
        elif cur is not None and not line.startswith(("global ", "note ")):
            cur.lines.append(line)
            if s:
                cur.end = i
        elif cur is None:
            header.append(line)
    names = {f.name for f in fns}
    for f in fns:
        for line in f.lines[1:]:
            for tok in line.split():
                if tok in names:
                    f.calls.add(tok)
        while f.lines and not f.lines[-1].strip():
            f.lines.pop()
    return header, fns, orig


def closure(fn, byname):
    seen, stack = [], [fn.name]
    while stack:
        n = stack.pop()
        if n in seen:
            continue
        seen.append(n)
        stack.extend(sorted(byname[n].calls))
    return seen


def recursive(fn, byname):
    """True if fn's closure contains a call cycle (omc function mode error 9, IR mode error 3)."""
    for n in closure(fn, byname):
        for c in byname[n].calls:
            if n in closure(byname[c], byname):
                return True
    return False


def topo(names, byname):
    out, state = [], {}

    def visit(n):
        if state.get(n) == 2:
            return
        if state.get(n) == 1:
            return       # cycle: order is arbitrary, the compiler will refuse it
        state[n] = 1
        for c in sorted(byname[n].calls):
            if c in names:
                visit(c)
        state[n] = 2
        out.append(n)
    for n in names:
        visit(n)
    return out


def unit_text(names, byname):
    return "\n".join("\n".join(byname[n].lines) for n in names) + "\n"


def owner_at(text, line):
    """The function whose body contains 1-based `line` of `text` (last `fn ` header at or above it)."""
    name = None
    for i, l in enumerate(text.split("\n"), 1):
        if i > line:
            break
        if l.startswith("fn "):
            name = l.split()[1]
    return name


OMC_ERR = re.compile(r"(\w+): line (\d+): error (\d+)")


# ---------------------------------------------------------------- conversions (Spark)
def expected_refusal(kind, fn, byname):
    """Why a refusal of fn by this compiler is the documented one (None = unexpected)."""
    if recursive(fn, byname):
        return {"toc": "call cycle: toc library mode refuses recursion (omc error 9)",
                "native": "call cycle: omc function mode refuses recursion (error 9)",
                "wasm": "call cycle: IR mode calls only earlier functions (error 3)"}[kind]
    if kind == "native":
        if len(fn.params) > 6:
            return "more than 6 parameters (native ABI v1)"
        for _, t in fn.params:
            if t not in ("ulong", "long"):
                return "parameter type %s outside native ABI v1 (ulong, long, ulong/uchar arrays)" % t
        if fn.ret not in ("ulong", "long", "void"):
            return "result type %s outside native ABI v1 (ulong, long, void)" % fn.ret
    if kind == "wasm" and not fn.scalar:
        return "IR mode is scalar only"
    return None


TOOL = {"toc": "omega-bridge toc (bootstrap omc %s)", "native": "omc 734f0a39 function mode + native.om",
        "wasm": "omega-mv omc ir + irwasm"}


def converge(kind, op, om_text, line_offset=0):
    """Send the unit; when the compiler refuses, attribute the refusal to the function at the
    reported line, drop it and every function that calls it, and resend the rest.
    Returns {"rc", "out", "exported", "refused": {name: {msg, rc, tool, expected}}, "ms", "err"}."""
    header, fns, _ = parse_unit(om_text.decode())
    byname = {f.name: f for f in fns}
    todo = [f.name for f in fns]
    if kind == "wasm":
        todo = topo(todo, byname)
        data = unit_text(todo, byname).encode()
    else:
        data = om_text
    refused, ms_total = {}, 0.0
    tool = TOOL[kind] % PINS.get("BOOT_OMC_SHA256", "")[:8] if kind == "toc" else TOOL[kind]
    while todo:
        if kind == "native":
            units = []
            for n in todo:
                units.append(topo([c for c in closure(byname[n], byname) if c != n], byname) + [n])
            texts = [unit_text(u, byname) for u in units]
            data = "#omb-unit\n".join(texts).encode()
        rc, out, err, ms, _ = remote(op, data)
        ms_total += ms
        errs = err.decode(errors="replace")
        if rc == 0:
            return {"rc": 0, "out": out, "exported": todo, "refused": refused, "ms": ms_total, "err": errs, "sent": data}
        newly = {}
        for line in errs.splitlines():
            text, msg, unit_fn = data.decode(), line, None
            mu = re.match(r"omb-remote: unit (\d+): (.*)", line)
            if kind == "native":
                if not mu or int(mu.group(1)) > len(todo):
                    continue
                k = int(mu.group(1)) - 1
                text, msg, unit_fn = texts[k], mu.group(2), todo[k]
            m = OMC_ERR.search(msg)
            owner = owner_at(text, int(m.group(2)) - line_offset) if m else None
            if unit_fn:
                where = " (in helper %s)" % owner if owner and owner != unit_fn else ""
                newly[unit_fn] = msg + where
            elif owner in todo:
                newly[owner] = msg + " (line %d of the unit sent = fn %s)" % (int(m.group(2)) - line_offset, owner)
        if not newly:
            for n in todo:
                refused[n] = {"msg": errs.strip() or "exit %d" % rc, "rc": rc, "tool": tool, "expected": None}
            break
        for n, msg in newly.items():
            refused[n] = {"msg": msg, "rc": rc, "tool": tool, "expected": expected_refusal(kind, byname[n], byname)}
        for n in todo:
            if n in refused:
                continue
            bad = [x for x in newly if x in closure(byname[n], byname)]
            if bad:
                refused[n] = {"msg": "calls refused function %s" % bad[0], "rc": rc, "tool": tool,
                              "expected": refused[bad[0]]["expected"] and "depends on " + bad[0]}
        todo = [n for n in todo if n not in refused]
        if kind == "toc":
            data = ("\n".join(h for h in header if h.strip()) + "\n" if any(h.strip() for h in header) else "").encode() \
                + unit_text(todo, byname).encode()
        elif kind == "wasm":
            data = unit_text(todo, byname).encode()
    return {"rc": 1, "out": b"", "exported": [], "refused": refused, "ms": ms_total, "err": "", "sent": b""}


def toc(om, lang):
    return converge("toc", "toc-c" if lang == "c" else "toc-py", om)


def native(om_text):
    """.om unit -> one C binding. Each function F is one unit: its callees (topological), then F
    last, which native.om exports as omega_F."""
    r = converge("native", "native-c", om_text)
    r["hex"] = {}
    for m in re.finditer(r"ombr_code_(\w+):\\n\.byte ([0-9a-fx,]+)", r["out"].decode(errors="replace")):
        r["hex"][m.group(1)] = "".join("%02x" % int(b, 16) for b in m.group(2).split(","))
    return r


def wasm(om_text):
    """.om unit -> one wasm module (topological order; IR mode reads an extra 'ir' line first)."""
    return converge("wasm", "wasm", om_text, line_offset=1)

# ---------------------------------------------------------------- values
def typed_range(t):
    w, s = TYPES[t]
    return (-(1 << (w - 1)), (1 << (w - 1)) - 1) if s else (0, (1 << w) - 1)


def to_bits(v):
    return v & M64


def from_bits(b, t):
    if t == "void":
        return 0
    w, s = TYPES[t]
    b &= M64
    if s:
        return b - (1 << 64) if b >> 63 else b
    return b


def edge_values(t, lo, hi):
    vals = {lo, hi, 0, 1, 2, -1, -2, lo + 1, hi - 1, 3, 7, 10, 100}
    w = TYPES[t][0]
    for k in range(1, w + 1):
        for d in (-1, 0, 1):
            vals.add((1 << k) + d)
            vals.add(-(1 << k) + d)
    return sorted(v for v in vals if lo <= v <= hi)


def gen_vectors(fn, n, seed, domain=None):
    """Seeded vectors in each parameter's valid domain (type range, narrowed by DOMAIN.json),
    edge values first, then small, medium and full-range random values."""
    rng = random.Random("%s:%s" % (seed, fn.name))
    ranges = []
    for i, (_, t) in enumerate(fn.params):
        lo, hi = typed_range(t)
        if domain and i < len(domain) and domain[i]:
            lo, hi = max(lo, domain[i][0]), min(hi, domain[i][1])
        ranges.append((t, lo, hi))
    if not ranges:
        return [()]
    out, seen = [], set()

    def add(v):
        if v not in seen:
            seen.add(v)
            out.append(v)
    edges = [edge_values(t, lo, hi) for t, lo, hi in ranges]
    for _ in range(n * 4):
        if len(out) >= n // 3:
            break
        add(tuple(rng.choice(e) for e in edges))
    tries = 0
    while len(out) < n and tries < n * 50:
        tries += 1
        v = []
        for t, lo, hi in ranges:
            r = rng.random()
            if r < 0.45:
                a, b = max(lo, -100), min(hi, 100)
            elif r < 0.75:
                a, b = max(lo, -(1 << 20)), min(hi, 1 << 20)
            else:
                a, b = lo, hi
            if a > b:
                a, b = lo, hi
            v.append(rng.randint(a, b))
        add(tuple(v))
    return out


# ---------------------------------------------------------------- form runners (on this Mac)
def build_dir(*parts):
    h = hashlib.sha256(b"\0".join(p if isinstance(p, bytes) else p.encode() for p in parts)).hexdigest()[:20]
    d = os.path.join(WORK, "build", h)
    os.makedirs(d, exist_ok=True)
    return d


def vec_lines(fns, vectors):
    """vectors: list of (fn_index, values). Line: index then canonical 64-bit bits."""
    return "".join("%d %s\n" % (k, " ".join(str(to_bits(x)) for x in v)) for k, v in vectors).encode()


def c_driver(fns, header):
    cases = []
    for k, f in enumerate(fns):
        args = ", ".join("a[%d]" % i for i in range(len(f.params)))
        cases.append("case %d: s=omega_%s(&r%s%s); break;" % (k, f.name, ", " if args else "", args))
    return ("#include <stdio.h>\n#include <stdint.h>\n#include <inttypes.h>\n%s\n"
            "int main(void){int k;uint64_t a[8]={0},r;uint32_t s;\n"
            "while(scanf(\"%%d\",&k)==1){int n=0;switch(k){%s default:return 70;}\n"
            "for(int i=0;i<n;i++)if(scanf(\"%%\" SCNu64,&a[i])!=1)return 71;\n"
            "r=0;switch(k){%s default:return 70;}\n"
            "if(s)printf(\"T %%u\\n\",s);else printf(\"0 %%\" PRIu64 \"\\n\",r);}\n"
            "return 0;}\n") % (header, " ".join("case %d: n=%d; break;" % (k, len(f.params)) for k, f in enumerate(fns)),
                               " ".join(cases))


def parse_results(out, fns, vectors, form):
    res = []
    lines = out.decode(errors="replace").splitlines()
    for i, (k, v) in enumerate(vectors):
        if i >= len(lines):
            res.append(("err", "no output (process ended early)"))
            continue
        line = lines[i]
        if line.startswith("0 "):
            res.append(("ok", from_bits(int(line[2:]), fns[k].ret)))
        elif line.startswith("T "):
            c = line[2:].strip()
            res.append(("trap", int(c) if c.isdigit() else None))
        elif line.startswith("V "):
            res.append(("ok", int(line[2:])))
        else:
            res.append(("err", line[2:] if len(line) > 2 else line))
    return res


def compile_c(sources, out, extra=()):
    cmd = [cc(), "-std=gnu11", "-O2", "-w"] + list(extra) + ["-o", out] + sources
    rc, _, err, ms = run_local(cmd, show=sh_join([os.path.relpath(c, KIT) if c.startswith(KIT) else c for c in cmd]))
    return rc, err.decode(errors="replace")


def run_omega_c(c_src, fns, vectors, kind):
    """Generated C (toc) or native binding C, called through omega_<name>."""
    d = build_dir(kind, c_src, ",".join(f.sig() for f in fns))
    exe = os.path.join(d, "run")
    if not os.path.exists(exe):
        lib = os.path.join(d, "unit.c")
        open(lib, "wb").write(c_src)
        drv = os.path.join(d, "driver.c")
        if kind == "toc":
            open(drv, "w").write(c_driver(fns, '#include "unit.c"'))
            rc, err = compile_c([drv], exe + ".tmp")
        else:
            protos = "\n".join("uint32_t omega_%s(uint64_t *r%s);" % (f.name, "".join(", uint64_t" for _ in f.params)) for f in fns)
            open(drv, "w").write(c_driver(fns, protos))
            rc, err = compile_c([drv, lib], exe + ".tmp")
        if rc:
            return None, "clang build failed on %s: %s" % (host_name(), first_error(err)), 0
        os.replace(exe + ".tmp", exe)
    rc, out, err, ms = run_local([exe], vec_lines(fns, vectors), show="%s < vectors" % os.path.relpath(exe, KIT))
    if rc:
        return None, "runner exit %d: %s" % (rc, err.decode(errors="replace")[:300]), ms
    return parse_results(out, fns, vectors, kind), None, ms


def first_error(err):
    for line in err.splitlines():
        if "error" in line:
            return line.strip()[:300]
    return err.strip()[:300]


