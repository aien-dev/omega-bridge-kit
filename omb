def orig_c_driver(path, fns, origname):
    cases = []
    for k, f in enumerate(fns):
        args = ", ".join("(%s)(%s)a[%d]" % (CTYPE[t], "int64_t" if TYPES[t][1] else "uint64_t", i) for i, (_, t) in enumerate(f.params))
        call = "%s(%s)" % (origname.get(f.name, f.name), args)
        if f.ret == "void":
            body = "%s; printf(\"V 0\\n\");" % call
        elif TYPES[f.ret][1]:
            body = "printf(\"V %%lld\\n\",(long long)(%s)%s);" % (CTYPE[f.ret], call)
        else:
            body = "printf(\"V %%llu\\n\",(unsigned long long)(%s)%s);" % (CTYPE[f.ret], call)
        cases.append("case %d: %s break;" % (k, body))
    nargs = " ".join("case %d: n=%d; break;" % (k, len(f.params)) for k, f in enumerate(fns))
    return r'''#include "%s"
#undef main
#include <stdio.h>
#include <stdint.h>
#include <inttypes.h>
#include <unistd.h>
#include <signal.h>
#include <sys/wait.h>
/* One fork per vector: a crash, undefined behaviour (UBSan) or a hang in the original cannot take
   the harness down; it is reported as E for that vector only. */
int main(void){int k;
while(scanf("%%d",&k)==1){int n=0;int64_t a[8]={0};switch(k){%s default:return 70;}
 for(int i=0;i<n;i++){char t[32];if(scanf("%%31s",t)!=1)return 71;a[i]=(int64_t)strtoull(t,0,10);}
 fflush(stdout);pid_t p=fork();
 if(p==0){alarm(2);switch(k){%s default:_exit(70);}fflush(stdout);_exit(0);}
 int st=0;waitpid(p,&st,0);
 if(WIFSIGNALED(st))printf("E signal %%d\n",WTERMSIG(st));
 else if(WEXITSTATUS(st))printf("E exit %%d (UBSan or the original's own exit)\n",WEXITSTATUS(st));
 fflush(stdout);}
return 0;}
''' % (path, nargs, " ".join(cases))


def run_orig_c(path, fns, vectors, origname):
    src = open(path, "rb").read()
