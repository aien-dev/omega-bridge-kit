# ---------------------------------------------------------------- comparison
def compare(form, ref, got, lang=None):
    """Return (verdict, detail) for one vector. verdict: match | mismatch | excluded."""
    if ref[0] == "trap":
        if form == "ORIGINAL":
            return "excluded", "Omega trapped (%s); outside the Omega function's defined domain" % TRAPS.get(ref[1], ref[1])
        if got[0] == "trap" and (got[1] is None or got[1] == ref[1]):
            return "match", ""
        return "mismatch", "want trap %s, got %s" % (ref[1], got)
    if ref[0] != "ok":
        return "mismatch", "reference error %s" % (ref,)
    if got[0] == "ok" and got[1] == ref[1]:
        return "match", ""
    if form == "ORIGINAL" and got[0] == "err" and lang == "c":
        return "excluded", "original C: %s (no defined C result)" % got[1]
    return "mismatch", "want %s, got %s" % (ref[1], got[1] if got[0] == "ok" else got)


# ---------------------------------------------------------------- one source through every form
def load_domain(path):
    p = os.path.join(os.path.dirname(path), "DOMAIN.json")
    if os.path.exists(p):
        return json.load(open(p)).get(os.path.basename(path), {})
    return {}


def originals_in(src, lang):
    text = src.decode(errors="replace")
    if lang == "py":
        return set(re.findall(r"^def\s+(\w+)\s*\(", text, re.M))
    return set(re.findall(r"^[A-Za-z_][\w \t\*]*?\b(\w+)\s*\([^;{]*\)\s*\{", text, re.M))


def prepare(path, need_rt=True):
    """Lift (if needed) and convert one file into every form. Returns a dict describing it."""
    ext = os.path.splitext(path)[1]
    lang = {".c": "c", ".py": "py", ".om": "om"}.get(ext)
    if not lang:
        raise OmbError("%s: not .c, .py or .om" % path, 64)
    src = open(path, "rb").read()
    P = {"path": path, "lang": lang, "src": src, "notes": [], "lift": None}
    if lang == "om":
        om = src
    else:
        rc, om, err, ms, where = lift(lang, src, "c")
        skips, fatal, other = parse_lift_err(err)
        P["lift"] = {"rc": rc, "ms": ms, "skips": skips, "fatal": fatal, "other": other, "where": HERE + " (clang-built lift.c)"}
        rc2, om2, err2, ms2, _ = lift(lang, src, "py")
        P["lift"]["py_agrees"] = (rc2 == rc and om2 == om and err2 == err)
        P["lift"]["py_ms"] = ms2
        try:
            rc3, om3, _, ms3, _ = lift(lang, src, "spark")
            P["lift"]["spark_agrees"] = (rc3 == rc and om3 == om)
        except OmbError as e:
            P["lift"]["spark_agrees"] = None
            P["lift"]["spark_note"] = str(e)
        if rc or not om:
            P["om"] = None
            return P
    P["om"] = om
    header, fns, orig = parse_unit(om.decode())
    P["fns"], P["origname"], P["byname"] = fns, orig, {f.name: f for f in fns}
    if lang in ("c", "py"):
        names = originals_in(src, lang)
        P["has_original"] = {f.name: orig.get(f.name, f.name) in names for f in fns}
    else:
        P["has_original"] = {f.name: False for f in fns}
    P["c"] = toc(om, "c")
    P["py"] = toc(om, "py")
    P["native"] = native(om)
    P["wasm"] = wasm(om)
    if need_rt and lifter_status() is None:
        P["rt"] = {}
        for lang2, gen in (("c", P["c"]), ("py", P["py"])):
            if gen["rc"]:
                continue
            rc, om_rt, err, ms, _ = lift(lang2, gen["out"], "c")
            entry = {"lift_rc": rc, "lift_err": err.decode(errors="replace"), "om": om_rt}
            if rc == 0:
                again = toc(om_rt, lang2)
                entry["gen"] = again
                entry["identical"] = again["rc"] == 0 and again["out"] == gen["out"]
            else:
                entry["identical"] = False
            P["rt"][lang2] = entry
    else:
        P["rt"] = None
    return P


def run_forms(P, vectors_by_fn, forms=None):
    """vectors_by_fn: {name: [values,...]}. Returns {form: {"results": {name: [...]}, "ms", "error"}}.
    Each form runs only the functions its compiler exported."""
    scalar = [f for f in P["fns"] if f.scalar]
    out = {}
    forms = forms or FORMS

    def go(form, names, runner):
        fs = [f for f in scalar if f.name in names]
        if not fs:
            return
        vecs = [(k, v) for k, f in enumerate(fs) for v in vectors_by_fn.get(f.name, [])]
        res, err, ms = runner(fs, vecs)
        if res is None:
            out[form] = {"results": None, "error": err, "ms": ms}
            return
        d = {f.name: [] for f in fs}
        for (k, _), r in zip(vecs, res):
            d[fs[k].name].append(r)
        out[form] = {"results": d, "error": None, "ms": ms}

    def gen_c(g, kind):
        return lambda fs, vecs: run_omega_c(g["out"], fs, vecs, kind)

    def gen_py(g):
        return lambda fs, vecs: run_omega_py(g["out"], fs, vecs)

    if "OM>C" in forms:
        go("OM>C", P["c"]["exported"], gen_c(P["c"], "toc"))
    if "OM>PY" in forms:
        go("OM>PY", P["py"]["exported"], gen_py(P["py"]))
    if "NATIVE" in forms:
        go("NATIVE", P["native"]["exported"], gen_c(P["native"], "native"))
    if "WASM" in forms:
        go("WASM", P["wasm"]["exported"], lambda fs, vecs: run_wasm_jsc(P["wasm"]["out"], fs, vecs))
    if "ORIGINAL" in forms and P["lang"] in ("c", "py"):
        runner = run_orig_c if P["lang"] == "c" else run_orig_py
        go("ORIGINAL", [n for n, h in P["has_original"].items() if h],
           lambda fs, vecs: runner(P["path"], fs, vecs, P["origname"]))
    for lang2, form in (("c", "RT-C"), ("py", "RT-PY")):
        e = (P.get("rt") or {}).get(lang2)
        if form in forms and e and e.get("gen"):
            go(form, e["gen"]["exported"], gen_c(e["gen"], "toc") if lang2 == "c" else gen_py(e["gen"]))
    return out


def form_status(P, form, fname, runs, vectors):
    """Cell for one function x form: dict(state=PASS|FAIL|REFUSED|UNEXPECTED_REFUSAL|NOT_RUN|N/A, ...)."""
    f = P["byname"][fname]
    if not f.scalar:
        return {"state": "N/A", "why": "array signature: outside the kit's scalar matrix"}
    if form == "ORIGINAL" and not P["has_original"].get(fname):
        return {"state": "N/A", "why": "no original function of this name (lifter helper or .om input)"}
    for form2, key in (("OM>C", "c"), ("OM>PY", "py"), ("NATIVE", "native"), ("WASM", "wasm")):
        if form == form2 and fname in P[key]["refused"]:
            r = P[key]["refused"][fname]
            return {"state": "REFUSED" if r["expected"] else "UNEXPECTED_REFUSAL",
                    "why": "REFUSED by %s: %s" % (r["tool"], r["msg"]) + ("  [expected: %s]" % r["expected"] if r["expected"] else ""),
                    "expected": r["expected"]}
    if form in ("RT-C", "RT-PY"):
        if P.get("rt") is None:
            return {"state": "NOT_RUN", "why": lifter_status() or "round trip not requested"}
        e = P["rt"].get("c" if form == "RT-C" else "py")
        if not e:
            return {"state": "N/A", "why": "toc produced nothing to lift back"}
        if e["lift_rc"]:
            return {"state": "FAIL", "why": "lifter refused toc output: " + e["lift_err"].strip()[:200]}
        if fname not in e["gen"]["exported"]:
            if fname not in P["c"]["exported"]:
                return {"state": "N/A", "why": "toc refused the function; nothing to round-trip"}
            return {"state": "FAIL", "why": "function missing after the round trip"}
    if fname not in P["c"]["exported"] and fname not in P["py"]["exported"]:
        return {"state": "N/A", "why": "every toc form refused this function; no Omega reference to compare"}
    run = runs.get(form)
    if run is None:
        return {"state": "NOT_RUN", "why": "form not produced"}
    if run["results"] is None:
        return {"state": "NOT_RUN", "why": run["error"]}
    want = None
    for rf in ("OM>C", "OM>PY"):
        r = runs.get(rf)
        if r and r["results"] and r["results"].get(fname) is not None:
            want = r["results"][fname]
            break
    if want is None:
        return {"state": "NOT_RUN", "why": "no Omega reference (OM>C or OM>PY) ran"}
    got = run["results"].get(fname)
    if got is None or want is None or len(got) != len(want):
        return {"state": "NOT_RUN", "why": "results missing"}
    n_match = n_excl = 0
    bad = []
    excl_why = {}
    for i, (w, g) in enumerate(zip(want, got)):
        v, why = compare(form, w, g, P["lang"])
        if v == "match":
            n_match += 1
        elif v == "excluded":
            n_excl += 1
            excl_why[why.split(";")[0]] = excl_why.get(why.split(";")[0], 0) + 1
        else:
            bad.append({"args": list(vectors[fname][i]), "detail": why})
    st = {"state": "PASS" if not bad and n_match else "FAIL", "match": n_match, "excluded": n_excl,
          "total": len(want), "bad": bad[:5], "n_bad": len(bad), "excluded_why": excl_why, "ms": run["ms"]}
    if not bad and not n_match:
        st["why"] = "every vector excluded; nothing compared"
    return st


# ---------------------------------------------------------------- negative control
MUTATIONS = [(r"\badd\b", "sub"), (r"\bsub\b", "add"), (r"\bmul\b", "add"), (r"\bdiv\b", "mul"), (r"\brem\b", "div")]


def mutate(om_text, fn):
    """Yield (mutated_text, description) for fn's body: first arithmetic op swap, else a constant +1,
    else a comparison flip."""
    lines = om_text.split("\n")
    body = range(fn.start, fn.end)       # 0-based indices of body lines after the header line
    for pat, rep in MUTATIONS:
        for i in body:
            if re.search(pat, lines[i]):
                new = lines[:]
                new[i] = re.sub(pat, rep, lines[i], count=1)
                yield "\n".join(new), "line %d: %r -> %r" % (i + 1, lines[i].strip(), new[i].strip())
    for i in body:
        m = re.search(r"(?<![\w-])(\d+)\b", lines[i])
        if m:
            new = lines[:]
            new[i] = lines[i][:m.start(1)] + str(int(m.group(1)) + 1) + lines[i][m.end(1):]
            yield "\n".join(new), "line %d: %r -> %r (constant +1)" % (i + 1, lines[i].strip(), new[i].strip())
    for a, b in (("ne", "eq"), ("eq", "ne"), ("lt", "ge"), ("gt", "le"), ("le", "gt"), ("ge", "lt")):
        for i in body:
            if re.search(r"\b%s\b" % a, lines[i]):
                new = lines[:]
                new[i] = re.sub(r"\b%s\b" % a, b, lines[i], count=1)
                yield "\n".join(new), "line %d: %r -> %r" % (i + 1, lines[i].strip(), new[i].strip())


def negative_control(P, vectors, runs):
    """Mutate one function's .om, send it through the real path (Spark toc -> clang on the Mac),
    and require the differential against the oracle (original if present, else unmutated OM>C) to FAIL."""
    cand = [f for f in P["fns"] if f.scalar and vectors.get(f.name) and f.name in P["c"]["exported"]]
    cand.sort(key=lambda f: not P["has_original"].get(f.name))
    if not cand:
        return {"state": "NOT_RUN", "why": "no scalar function to mutate"}
    f = cand[0]
    oracle = "ORIGINAL" if P["has_original"].get(f.name) and runs.get("ORIGINAL", {}).get("results") else "OM>C"
    want = runs.get(oracle, {}).get("results", {}) or {}
    want = want.get(f.name)
    if want is None:
        return {"state": "NOT_RUN", "why": "oracle %s did not run" % oracle}
    tried = []
    for text, desc in mutate(P["om"].decode(), f):
        gen = toc(text.encode(), "c")
        if f.name not in gen["exported"]:
            tried.append(desc + " (toc refused the mutant)")
            continue
        fns = [g for g in P["fns"] if g.scalar and g.name in gen["exported"]]
        vecs = [(fns.index(f), v) for v in vectors[f.name]]
        res, err, ms = run_omega_c(gen["out"], fns, vecs, "toc")
        if res is None:
            tried.append(desc + " (" + err + ")")
            continue
        bad = 0
        for i, (w, g) in enumerate(zip(want, res)):
            if oracle == "ORIGINAL" and (w[0] != "ok" or runs["OM>C"]["results"][f.name][i][0] != "ok"):
                continue     # same exclusions as the differential itself
            if w != g:
                bad += 1
        return {"state": "CAUGHT" if bad else "MISSED", "fn": f.name, "mutation": desc, "oracle": oracle,
                "mismatches": bad, "total": len(want), "tried": tried}
    return {"state": "NOT_RUN", "why": "no mutation compiled", "tried": tried}


# ---------------------------------------------------------------- reporting
def mark(st):
    s = st["state"]
    if s == "PASS":
        x = "✓ %d/%d" % (st["match"], st["total"] - st["excluded"])
        if st["excluded"]:
            x += " (+%d excl)" % st["excluded"]
        return x + " %.0fms" % st["ms"]
    if s == "FAIL":
        return "✗ %d bad" % st.get("n_bad", 0) if "n_bad" in st else "✗ FAIL"
    if s == "REFUSED":
        return "REFUSED (expected)"
    if s == "UNEXPECTED_REFUSAL":
        return "✗ REFUSED"
    return s


def emit(rec):
    sys.stdout.write(json.dumps(rec, default=lambda o: o.hex() if isinstance(o, bytes) else str(o)) + "\n")


def table(rows, head):
    w = [max(len(str(r[i])) for r in [head] + rows) for i in range(len(head))]
    fmt = "  ".join("%%-%ds" % x for x in w)
    print(fmt % tuple(head))
    print("  ".join("-" * x for x in w))
    for r in rows:
        print(fmt % tuple(r))


def discover(paths):
    if paths:
        return paths
    out = []
    for d in ("samples", "picks"):
        p = os.path.join(KIT, d)
        if os.path.isdir(p):
            out += sorted(os.path.join(p, f) for f in os.listdir(p) if os.path.splitext(f)[1] in (".c", ".py", ".om"))
    return out


def verify(paths, quick, as_json):
    n = 64 if quick else 500
    worst = 0
    summary = []
    for path in discover(paths):
        rel = os.path.relpath(path, KIT)
        try:
            P = prepare(path)
        except OmbError as e:
            if as_json:
                emit({"file": rel, "state": "NOT_RUN", "why": str(e)})
            else:
                print("\n== %s\nNOT_RUN: %s" % (rel, e))
            worst = max(worst, 2)
            summary.append((rel, "NOT_RUN"))
            continue
        if not as_json:
            print("\n== %s  (%s)" % (rel, {"c": "original C", "py": "original Python", "om": ".om unit"}[P["lang"]]))
        if P["lift"]:
            L = P["lift"]
            if as_json:
                emit({"file": rel, "lift": {k: v for k, v in L.items()}})
            else:
                print("lift [%s, clang-built lift.c] rc=%d %.0fms; python3 lift.py agrees: %s; Spark lifter agrees: %s" % (
                    HERE, L["rc"], L["ms"], "✓" if L["py_agrees"] else "✗", {True: "✓", False: "✗", None: "NOT_RUN"}[L["spark_agrees"]]))
                for s in L["skips"]:
                    print("  skipped %s (line %d): %s" % (s["name"], s["line"], s["reason"]))
                for s in L["fatal"]:
                    print("  refused line %d: %s" % (s["line"], s["reason"]))
            if not L["py_agrees"] or L["spark_agrees"] is False:
                worst = 1
            if P["om"] is None:
                worst = max(worst, 1 if L["fatal"] else 2)
                summary.append((rel, "LIFT REFUSED"))
                continue
        steps = [("toc C", P["c"]), ("toc Python", P["py"]), ("omc734+native.om", P["native"]), ("omc ir+irwasm", P["wasm"])]
        if as_json:
            emit({"file": rel, "converted_on": "SPARK via ssh " + SPARK,
                  "steps": {k: {"ms": round(v["ms"], 1), "exported": v["exported"], "refused": sorted(v["refused"])} for k, v in steps}})
        else:
            print("converted on SPARK via ssh %s: %s" % (SPARK, ", ".join("%s %s" % (k, "%.0fms" % v["ms"] if v["ms"] else "cached")
                                                                     for k, v in steps)))
            print("run on %s: every form below (clang, python3, jsc)" % HERE)
        domain = load_domain(path)
        vectors = {f.name: gen_vectors(f, n, "omb-1", domain.get(f.name)) for f in P["fns"] if f.scalar}
        runs = run_forms(P, vectors)
        rows = []
        for f in P["fns"]:
            cells = {form: form_status(P, form, f.name, runs, vectors) for form in FORMS}
            for form, st in cells.items():
                if st["state"] in ("FAIL", "UNEXPECTED_REFUSAL"):
                    worst = 1
                elif st["state"] == "NOT_RUN" and worst != 1:
                    worst = max(worst, 2)
            if as_json:
                emit({"file": rel, "fn": f.name, "sig": f.sig(), "vectors": len(vectors.get(f.name, [])), "forms": cells})
            rows.append([f.name, len(vectors.get(f.name, []))] + [mark(cells[x]) for x in FORMS])
            notes = [(x, c) for x, c in cells.items() if c["state"] not in ("PASS",) and c.get("why")]
            f._notes = notes + [(x, c) for x, c in cells.items() if c.get("bad")]
        if not as_json:
            table(rows, ["function", "vectors"] + ["%s[%s]" % (x, FORM_WHERE[x]) for x in FORMS])
            for f in P["fns"]:
                for x, c in f._notes:
                    if c.get("why"):
                        print("  %s %s: %s" % (f.name, x, c["why"]))
                    for b in c.get("bad", []):
                        print("  %s %s ✗ args %s: %s" % (f.name, x, b["args"], b["detail"]))
                for x in FORMS:
                    c = form_status(P, x, f.name, runs, vectors)
                    for why, k in c.get("excluded_why", {}).items():
                        print("  %s %s: %d vectors excluded: %s" % (f.name, x, k, why))
        if P.get("rt"):
            for lang2 in ("c", "py"):
                e = P["rt"].get(lang2)
                if not e:
                    continue
                ok = e["identical"]
                if not ok:
                    worst = 1
                if as_json:
                    emit({"file": rel, "roundtrip": lang2, "identical": ok})
                else:
                    print("round trip %s: bridge %s (lift %s (bridge %s X)) == bridge %s X  byte-identical: %s" % (
                        lang2, lang2, lang2, lang2, lang2, "✓" if ok else "✗"))
        ctl = negative_control(P, vectors, runs)
        if as_json:
            emit({"file": rel, "control": ctl})
        else:
            if ctl["state"] == "CAUGHT":
                print("negative control: %s %s -> differential vs %s FAIL (%d/%d differ) -> caught ✓" % (
                    ctl["fn"], ctl["mutation"], ctl["oracle"], ctl["mismatches"], ctl["total"]))
            else:
                print("negative control: %s %s" % (ctl["state"], ctl.get("why") or ctl.get("mutation")))
        if ctl["state"] == "MISSED" and worst != 1:
            worst = 3
        elif ctl["state"] == "NOT_RUN" and worst == 0:
            worst = 2
        summary.append((rel, ctl["state"]))
    verdict = {0: "PASS", 1: "FAIL", 2: "NOT_RUN present", 3: "CONTROL MISSED"}[worst]
    if as_json:
        emit({"verdict": verdict, "exit": worst, "spark": SPARK, "pins_sha256": PINS_SHA})
    else:
        print("\nverify: %s (exit %d). Mac: %s; Spark steps via ssh %s; PINS sha256 %s" % (verdict, worst, host_name(), SPARK, PINS_SHA[:16]))
    return worst


# ---------------------------------------------------------------- other commands
def parse_value(s):
    return int(s, 0)


def show_result(g):
    if g[0] == "ok":
        return str(g[1])
    if g[0] == "trap":
        return "trap %s" % (TRAPS.get(g[1], g[1]) if g[1] else "(wasm trap, no Omega code)")
    return "error " + str(g[1])


def run_one(P, fname, args):
    """Run every form of one function on one argument vector. Returns (fn, values, records)."""
    if P["om"] is None:
        raise OmbError("lifter refused %s" % P["path"], 1)
    fns = [f for f in P["fns"] if f.scalar]
    f = P["byname"].get(fname) if fname else (fns[0] if fns else None)
    if f is None:
        raise OmbError("function %s not in the unit (have: %s)" % (fname, ", ".join(x.name for x in P["fns"])), 64)
    vals = tuple(parse_value(str(a)) for a in args)
    if len(vals) != len(f.params):
        raise OmbError("%s takes %d arguments" % (f.sig(), len(f.params)), 64)
    for (pn, t), v in zip(f.params, vals):
        lo, hi = typed_range(t)
        if not lo <= v <= hi:
            raise OmbError("%s=%d outside %s range [%d, %d]" % (pn, v, t, lo, hi), 64)
    vectors = {f.name: [vals]}
    runs = run_forms(P, vectors)
    recs = []
    for form in FORMS:
        st = form_status(P, form, f.name, runs, vectors)
        r = runs.get(form)
        val = ""
        if r and r["results"] and r["results"].get(f.name):
            val = show_result(r["results"][f.name][0])
        why = st.get("why", "")
        if not why and st.get("bad"):
            why = st["bad"][0]["detail"]
        if not why and st.get("excluded"):
            why = "; ".join(st["excluded_why"])
        recs.append({"form": form, "where": FORM_WHERE[form], "value": val, "state": st["state"], "why": why,
                     "ms": round(r["ms"], 1) if r else None})
    return f, vals, recs


def cmd_run(path, fname, args, as_json):
    P = prepare(path, need_rt=True)
    f, vals, recs = run_one(P, fname, args)
    rows = []
    for rec in recs:
        if as_json:
            emit(dict(rec, fn=f.name, args=list(vals)))
        rows.append([rec["form"], rec["where"], rec["value"], {"PASS": "✓", "FAIL": "✗"}.get(rec["state"], rec["state"]),
                     "%.1f" % rec["ms"] if rec["ms"] is not None else "", rec["why"][:90]])
    if not as_json:
        print("%s%s" % (f.name, vals))
        table(rows, ["form", "where", "result", "match", "ms", "note"])
    return 1 if any(r["state"] in ("FAIL", "UNEXPECTED_REFUSAL") for r in recs) else 0


def cmd_convert(frm, to, path, as_json):
    src = open(path, "rb").read()
    if frm not in ("c", "py", "om") or to not in ("om", "c", "py", "native", "wasm"):
        raise OmbError("usage: omb convert c|py|om om|c|py|native|wasm FILE", 64)
    om = src
    if frm != "om":
        rc, om, err, ms, where = lift(frm, src, "c")
        sys.stderr.write(err.decode(errors="replace"))
        if rc:
            return rc
    if to == "om":
        sys.stdout.buffer.write(om)
        return 0
    if to in ("c", "py"):
        r = toc(om, to)
    else:
        r = native(om) if to == "native" else wasm(om)
    for n, x in r["refused"].items():
        sys.stderr.write("omb: %s REFUSED by %s: %s\n" % (n, x["tool"], x["msg"]))
    if r["rc"]:
        return 1
    sys.stdout.buffer.write(r["out"])
    return 1 if r["refused"] else 0


def cmd_roundtrip(path, as_json):
    P = prepare(path)
    if P["om"] is None:
        raise OmbError("lifter refused %s" % path, 1)
    if P["rt"] is None:
        raise OmbError(lifter_status() or "round trip not run", 2)
    rc = 0
    for lang2 in ("c", "py"):
        e = P["rt"].get(lang2)
        ok = bool(e and e["identical"])
        rc = rc or (0 if ok else 1)
        if as_json:
            emit({"file": path, "lang": lang2, "identical": ok})
        else:
            print("%s: bridge %s (lift %s (bridge %s X)) == bridge %s X: %s" % (path, lang2, lang2, lang2, lang2, "✓ byte-identical" if ok else "✗ differs"))
    return rc


def main(argv):
    global FRESH
    as_json = "--json" in argv
    FRESH = "--fresh" in argv
    argv = [a for a in argv if a not in ("--json", "--fresh")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0 if argv else 64
    op, rest = argv[0], argv[1:]
    try:
        if op == "setup":
            return setup()
        if op == "pins":
            print("# local PINS sha256 %s" % PINS_SHA)
            print(open(os.path.join(KIT, "PINS")).read().rstrip())
            rc, out, err, ms, _ = remote("pins", b"", cacheable=False)
            print("# --- Spark (%s) ---" % SPARK)
            sys.stdout.write(out.decode())
            print("# lifter on this Mac: %s" % (lifter_status() or "gen/lift.c and gen/lift.py match PINS"))
            return rc
        if op == "convert" and len(rest) == 3:
            return cmd_convert(rest[0], rest[1], rest[2], as_json)
        if op == "run" and rest:
            fname = None
            if "--fn" in rest:
                i = rest.index("--fn")
                fname = rest[i + 1]
                rest = rest[:i] + rest[i + 2:]
            with mac_lock():
                return cmd_run(rest[0], fname, rest[1:], as_json)
        if op == "roundtrip" and len(rest) == 1:
            return cmd_roundtrip(rest[0], as_json)
        if op == "verify":
            quick = "--quick" in rest
            with mac_lock():
                return verify([r for r in rest if r != "--quick"], quick, as_json)
    except OmbError as e:
        sys.stderr.write("omb: %s\n" % e)
        return e.code
    sys.stderr.write(__doc__)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
