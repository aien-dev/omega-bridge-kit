        for k, v in vectors:
            f = fns[k]
            fh.write("%s %s %s\n" % (f.name, f.ret, " ".join("%s:%d" % (t, x) for (_, t), x in zip(f.params, v))))
    rc, out, err, ms = run_local([JSC, js, "--", wf, vf], show="jsc %s -- %s %s" % (os.path.relpath(js, KIT), os.path.relpath(wf, KIT), os.path.relpath(vf, KIT)))
